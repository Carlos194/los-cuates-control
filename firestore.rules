rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.active == true;
    }
    // Los usuarios no pueden autorizarse a sí mismos.
    // Crea los miembros desde la consola de Firebase con ID = UID de Authentication.
    match /members/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /materials/{materialId} {
      allow read: if member();
      allow create, update: if member()
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'type', 'unitCost', 'createdAt', 'updatedBy'
        ])
        && request.resource.data.id == materialId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.type in ['mdf', 'termo', 'otro']
        && request.resource.data.unitCost is number
        && request.resource.data.unitCost >= 0
        && request.resource.data.unitCost < 1000000000;
      allow delete: if false;
    }
    match /works/{workId} {
      allow read: if member();
      allow create, update: if member()
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'price', 'materialId', 'createdAt', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.id == workId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.price < 1000000000
        && request.resource.data.materialId is string
        && exists(/databases/$(database)/documents/materials/$(request.resource.data.materialId));
      allow delete: if false;
    }
    match /orders/{orderId} {
      allow read: if member();
      allow create, update: if member()
        && request.resource.data.keys().hasOnly([
          'id', 'code', 'customer', 'description', 'total', 'materials',
          'extras', 'invoice', 'vatRate', 'status', 'notes',
          'payments', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.total < 1000000000
        && request.resource.data.materials is list
        && request.resource.data.materials.size() <= 50
        && request.resource.data.payments is list
        && request.resource.data.payments.size() <= 250;
      allow delete: if member()
        && resource.data.status == 'cancel'
        && resource.data.payments is list
        && resource.data.payments.size() == 0;
    }
    match /expenses/{expenseId} {
      allow read: if member();
      allow create, update: if member()
        && request.resource.data.keys().hasOnly([
          'id', 'description', 'amount', 'type', 'date', 'notes',
          'createdAt', 'createdBy', 'origin'
        ])
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount < 1000000000;
      allow delete: if false;
    }
    // Todo lo demás queda bloqueado.
  }
}
